{
  "name": "travel-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.21.0",
  "workspaces": [
    "firebase-functions",
    "packages/*",
    "workers/ocr"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/check-client-compatibility.mjs && tsc -b && vite build && node scripts/check-client-compatibility.mjs --dist",
    "lint": "eslint . && npm --workspaces --if-present run lint",
    "typecheck": "tsc -b --noEmit && npm --workspaces --if-present run typecheck",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "check:compatibility": "node scripts/check-client-compatibility.mjs",
    "test:rules": "firebase emulators:exec --project=demo-tripmate-rules --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "emulator:seed": "npm --workspace firebase-functions run emulator:seed",
    "functions:build": "npm --workspace firebase-functions run build",
    "functions:test": "npm --workspace firebase-functions test",
    "functions:artifacts:keep-one": "node scripts/deploy-prod-safe.mjs --artifacts-only",
    "functions:revisions:keep-one": "node scripts/deploy-prod-safe.mjs --revisions-only",
    "functions:deploy": "node scripts/deploy-prod-safe.mjs --functions-only",
    "worker:deploy": "node scripts/deploy-prod-safe.mjs --worker-only",
    "notifications:clear": "node scripts/deploy-prod-safe.mjs --clear-notifications-only",
    "icons": "node scripts/generate-icons.mjs",
    "deploy:prod": "node scripts/deploy-prod-safe.mjs",
    "deploy:pages": "node scripts/deploy-pages-prod.mjs",
    "deploy:pages:preview": "node scripts/deploy-pages-preview.mjs",
    "prepare": "husky"
  },
  "overrides": {
    "firebase-tools": {
      "chokidar": "^4.0.3",
      "basic-ftp": "^6.2.2"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    },
    "sharp": "$sharp",
    "undici": "^7.30.0",
    "uuid": "^11.1.1",
    "workbox-build": {
      "glob": "^13.0.6"
    },
    "rimraf": {
      "glob": "^13.0.6"
    },
    "eslint-plugin-react-hooks": {
      "zod-validation-error": "^4.0.2"
    }
  },
  "dependencies": {
    "@sentry/browser": "^10.76.0",
    "@tanstack/react-query": "^5.104.1",
    "@tripmate/expense-materialize": "file:./packages/expense-materialize",
    "@tripmate/fx-core": "file:./packages/fx-core",
    "@tripmate/pdf-page-limit": "file:./packages/pdf-page-limit",
    "@tripmate/route-estimate-core": "file:./packages/route-estimate-core",
    "@tripmate/settlement-core": "file:./packages/settlement-core",
    "firebase": "^12.17.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.52.0",
    "mapbox-gl": "^3.32.0",
    "pdfjs-dist": "5.4.296",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.4",
    "react-pdf": "10.4.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "15.32.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
