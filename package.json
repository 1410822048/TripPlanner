{
  "name": "travel-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "firebase-functions",
    "packages/*",
    "workers/ocr"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit && npm --workspaces --if-present run typecheck",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --project=demo-tripmate-rules --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "emulator:seed": "npm --workspace firebase-functions run emulator:seed",
    "functions:build": "npm --workspace firebase-functions run build",
    "functions:test": "npm --workspace firebase-functions test",
    "functions:artifacts:keep-one": "node scripts/deploy-prod-safe.mjs --artifacts-only",
    "functions:revisions:keep-one": "node scripts/deploy-prod-safe.mjs --revisions-only",
    "functions:deploy": "node scripts/deploy-prod-safe.mjs --functions-only",
    "worker:deploy": "node scripts/deploy-prod-safe.mjs --worker-only",
    "notifications:clear": "node scripts/deploy-prod-safe.mjs --clear-notifications-only",
    "icons": "node scripts/generate-icons.mjs",
    "deploy:prod": "node scripts/deploy-prod-safe.mjs",
    "deploy:pages": "node scripts/deploy-pages-prod.mjs",
    "deploy:pages:preview": "node scripts/deploy-pages-preview.mjs",
    "prepare": "husky"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "zod-validation-error": "^4.0.2"
    }
  },
  "dependencies": {
    "@sentry/browser": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@tripmate/expense-materialize": "file:./packages/expense-materialize",
    "@tripmate/fx-core": "file:./packages/fx-core",
    "@tripmate/pdf-page-limit": "file:./packages/pdf-page-limit",
    "@tripmate/route-estimate-core": "file:./packages/route-estimate-core",
    "@tripmate/settlement-core": "file:./packages/settlement-core",
    "firebase": "^12.17.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.28.0",
    "mapbox-gl": "^3.27.0",
    "pdfjs-dist": "5.4.296",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^5.5.7",
    "react-pdf": "10.4.1",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
