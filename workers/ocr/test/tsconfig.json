{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		// `types` REPLACES the parent's array rather than extending it, so
		// the parent's entries are repeated here. See ./pdfjs-dist.d.ts for
		// why adding the pool's types needs a shim alongside them.
		"types": [
			"../worker-configuration.d.ts",
			"node",
			"@cloudflare/vitest-pool-workers"
		]
	},
	"include": ["./**/*.ts", "../worker-configuration.d.ts"],
	"exclude": []
}
